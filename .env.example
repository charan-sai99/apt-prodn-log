# ---------------------------------------------------------------------------
# APT Production Log — environment variables
# Copy to .env.local for local development. Set the same names in Vercel.
# Never commit real values.
# ---------------------------------------------------------------------------

# Supabase API URL — Project Settings → API → "Project URL".
# It looks like https://<project-ref>.supabase.co
# (NOT the https://supabase.com/dashboard/... address)
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (sb_publishable_...). The legacy "anon" JWT key
# also works. NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as a fallback name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — secret key (sb_secret_...) or legacy service_role key.
# Needed only for creating/deactivating user accounts and resetting operator
# passwords from the admin pages, and for the data migration utility.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Operators without email log in with their employee code. The app turns the
# code into a sign-in address on this domain (e.g. op001@operators.apt.internal).
# Change only before creating the first operator accounts.
OPERATOR_LOGIN_DOMAIN=operators.apt.internal

# Public site URL used in password-reset links (e.g. https://apt-prodlog.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
